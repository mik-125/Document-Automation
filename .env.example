# Copy these values into your shell or private environment manager.
# Never commit the real service-account JSON file.
GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/outside-this-repository/service-account.json

# Use a restricted report folder inside an academy Google Shared Drive.
# Every member must be authorized for student data; give the service account
# Content Manager access.
# The folder can also be configured from the Connections page.
GOOGLE_REPORT_FOLDER_ID=

# Optional extra password protection on localhost. This MVP refuses public binds.
BRIGHTLINE_USERNAME=admin
BRIGHTLINE_PASSWORD=change-this-before-sharing
