# Copy these values into your shell or private environment manager.
# Never commit the real OAuth client JSON file.
GOOGLE_OAUTH_CLIENT_FILE=/absolute/path/outside-this-repository/google-oauth-client.json

# Optional. The default token path is data/google-oauth-token.json, which is ignored.
GOOGLE_OAUTH_TOKEN_FILE=

# Optional extra password protection on localhost. This MVP refuses public binds.
BRIGHTLINE_USERNAME=admin
BRIGHTLINE_PASSWORD=change-this-before-sharing

# Optional exact HTTPS origin for a trusted tunnel. Requires a password of 16+ characters.
BRIGHTLINE_PUBLIC_URL=
